{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Companion",
  "version": "../package.json",
  "identifier": "com.aicompanion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "onboarding",
        "url": "/onboarding.html",
        "title": "AI Companion — Setup",
        "width": 480,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "companion",
        "url": "/companion.html",
        "title": "AI Companion",
        "width": 240,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "chat",
        "url": "/chat.html",
        "title": "AI Companion — Chat",
        "width": 360,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "url": "/settings.html",
        "title": "AI Companion — Settings",
        "width": 560,
        "height": 660,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
